# =============================================================================
# Идентификаторы
# =============================================================================

variable "folder_id" {
  description = "ID папки Yandex Cloud"
  type        = string
}

variable "network_id" {
  description = "ID VPC, в которой создаётся кластер"
  type        = string
}

# =============================================================================
# Расположение мастера (3 зоны для регионального кластера)
# =============================================================================

variable "master_locations" {
  description = "Список расположений мастера (зона + ID подсети)"
  type = list(object({
    zone      = string
    subnet_id = string
  }))
}

# =============================================================================
# Группы безопасности
# =============================================================================

variable "security_group_ids" {
  description = "Список ID security groups для мастера"
  type        = list(string)
}

# =============================================================================
# Сервисные аккаунты
# =============================================================================

variable "service_account_id" {
  description = "ID существующего сервисного аккаунта для мастера"
  type        = string
}

variable "node_service_account_id" {
  description = "ID существующего сервисного аккаунта для узлов"
  type        = string
}

# =============================================================================
# Версия и канал обновлений
# =============================================================================

variable "cluster_version" {
  description = "Версия Kubernetes"
  type        = string
  default     = "1.35"
}

variable "release_channel" {
  description = "Канал обновлений (STABLE, RAPID, REGULAR)"
  type        = string
  default     = "STABLE"
}

# =============================================================================
# Туннельный режим (Cilium)
# =============================================================================

variable "enable_cilium_policy" {
  description = "Включить туннельный режим (Cilium) для поддержки внешних узлов"
  type        = bool
  default     = true
}

# =============================================================================
# Публичный доступ к мастеру
# =============================================================================

variable "public_access" {
  description = "Назначить публичный IP мастеру"
  type        = bool
  default     = true
}

# =============================================================================
# Размер etcd-кластера
# =============================================================================

variable "etcd_cluster_size" {
  description = "Количество экземпляров etcd (3 для регионального мастера)"
  type        = number
  default     = 3
}

# =============================================================================
# Политика обслуживания
# =============================================================================

variable "master_auto_upgrade" {
  description = "Автоматическое обновление мастера"
  type        = bool
  default     = true
}

variable "master_maintenance_windows" {
  description = "Окна обслуживания мастера"
  type = list(object({
    day        = string
    start_time = string
    duration   = string
  }))
  default = []
}

# =============================================================================
# CIDR-диапазоны (опционально)
# =============================================================================

variable "cluster_ipv4_range" {
  description = "CIDR для кластера (подов)"
  type        = string
  default     = null
}

variable "service_ipv4_range" {
  description = "CIDR для сервисов"
  type        = string
  default     = null
}

variable "node_ipv4_cidr_mask_size" {
  description = "Размер маски CIDR для узлов"
  type        = number
  default     = 24
}

# =============================================================================
# Имя и описание кластера
# =============================================================================

variable "cluster_name" {
  description = "Имя кластера"
  type        = string
  default     = "diplom-k8s"
}

variable "description" {
  description = "Описание кластера"
  type        = string
  default     = "Managed Kubernetes cluster for diploma project"
}

# =============================================================================
# Политика масштабирования мастера (опционально)
# =============================================================================

variable "master_scale_policy" {
  description = "ID ресурсного пресета для автомасштабирования мастера"
  type        = string
  default     = null
}

variable "log_group_id" {
  description = "ID группы логирования для отправки логов мастер-узлов"
  type        = string
}