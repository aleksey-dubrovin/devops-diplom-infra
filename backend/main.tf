# =============================================================================
# Главный файл конфигурации
# Назначение: провайдер Yandex Cloud и вызов модулей IAM и Storage
# =============================================================================

# -----------------------------------------------------------------------------
# Блок конфигурации Terraform
# -----------------------------------------------------------------------------
terraform {
  # Требуемая версия Terraform
  required_version = ">= 1.3.0"

  # Обязательные провайдеры
  required_providers {
    yandex = {
      source  = "yandex-cloud/yandex"
      version = "> 0.9"
    }
  }
}

# -----------------------------------------------------------------------------
# Конфигурация провайдера Yandex Cloud
# -----------------------------------------------------------------------------
provider "yandex" {
  token     = var.yandex_token
  cloud_id  = var.cloud_id
  folder_id = var.folder_id
  zone      = var.default_zone
}

# -----------------------------------------------------------------------------
# Модуль IAM: сервисный аккаунт и роли
# -----------------------------------------------------------------------------
module "iam" {
  source = "../modules/iam"
  sa_name     = var.sa_name
  folder_id   = var.folder_id
  # Роли: редактор папки, редактор хранилища, администратор реестра контейнеров, редактор DNS
  roles       = ["editor", "storage.editor", "container-registry.admin", "dns.editor"]
  create_sa   = false   # false – использовать существующий аккаунт
}

# -----------------------------------------------------------------------------
# Модуль Storage: S3-бакет для хранения состояния Terraform
# -----------------------------------------------------------------------------
module "storage" {
  source = "../modules/storage"
  bucket_name         = "${var.bucket_name}-${var.folder_id}"  # Уникальное имя бакета с добавлением ID папки
  service_account_id  = module.iam.service_account_id
  enable_versioning   = true
  force_destroy       = true
}
